2. build.gradle (Gradle Configuration)

plugins {
    id 'java'
    id 'org.springframework.boot' version '3.2.1'
    id 'io.spring.dependency-management' version '1.1.4'
}

group = 'com.example'
version = '1.0.0'
java.sourceCompatibility = '17'

repositories {
    mavenCentral()
}

dependencies {
    // Spring Boot
    implementation 'org.springframework.boot:spring-boot-starter-web'

    // Apache CXF for SOAP
    implementation 'org.apache.cxf:cxf-spring-boot-starter-jaxws:4.0.3'

    // JAXB for XML handling
    implementation 'jakarta.xml.bind:jakarta.xml.bind-api:3.0.1'
    implementation 'org.glassfish.jaxb:jaxb-runtime:3.0.1'

    // Apache HttpClient for SSL
    implementation 'org.apache.httpcomponents.client5:httpclient5:5.2.1'

    // WSDL Code Generation
    implementation 'org.apache.cxf:cxf-tools:4.0.3'
}

tasks.register('generateSoapClient', JavaExec) {
    mainClass = 'org.apache.cxf.tools.wsdlto.WSDLToJava'
    classpath = sourceSets.main.runtimeClasspath
    args = [
        '-d', "${projectDir}/src/main/java",
        '-p', 'com.example.soapclient.model',
        "${projectDir}/src/main/resources/wsdl/service.wsdl"
    ]
}

Run:

./gradlew generateSoapClient

This will generate Java classes from the WSDL in src/main/java/com/example/soapclient/model.

